{
  "name": "talksume",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:server": "pnpm --filter @talksume/cloud-server dev",
    "dev:web": "pnpm --filter @talksume/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
