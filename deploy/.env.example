POSTGRES_PASSWORD=change-me
WEB_PORT=8000
APP_VERSION=dev
LLM_BASE_URL=
LLM_API_KEY=
# 可选：bge-m3 等 OpenAI 兼容向量服务，不填则只用关键词召回
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# 可选：Qwen3-Reranker 等 /rerank 服务，对召回打分后的前 RERANK_TOP_K 个岗位（默认 100）做语义重排；key 不填则复用 EMBEDDING_API_KEY
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TOP_K=

# 邮件功能总开关，默认关（false）：不发任何邮件，不需要 SMTP；注册即视为已验证并直接登录；
# 忘记密码、重发验证邮件不可用，用户找管理员重置（管理后台「重置用户密码」，或服务器上跑 reset-password 脚本）。
# 设为 true 才启用邮箱验证 + 邮件找回，此时生产环境必须配好 APP_URL 和 SMTP_*，缺了 server 启动失败
AUTH_EMAIL_ENABLED=false

# 站点对外访问的完整地址（邮件链接、Origin 校验、Cookie Secure 判断都用它）。开邮件时生产必填；
# 关邮件时可以不填，此时 Origin 只放行主机名和请求 Host 一致的来源，建议仍然填上
APP_URL=
# 额外允许发起写请求的 Origin，逗号分隔，一般留空
ALLOWED_ORIGINS=
# 这些邮箱注册（关邮件）或注册并验证邮箱（开邮件）后自动成为管理员，逗号分隔
ADMIN_EMAILS=admin@example.com

# 邮件（仅 AUTH_EMAIL_ENABLED=true 时需要）。端口 465 走隐式 TLS，其余端口按服务器声明启用 STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=简聊 <no-reply@example.com>

# 反向代理层数，用来取真实 IP 做限流。默认只有 web 容器里的 nginx 一层
TRUST_PROXY_HOPS=1

# 仅联调：设成 development 时邮件内容打到 server 日志而不真发，Cookie 不加 Secure。生产不要设
# NODE_ENV=development

# 可选：容器内岗位 jsonl 路径（需自行挂载卷），库里没有岗位时启动导入；不设则岗位库为空
SEED_JOBS_PATH=
